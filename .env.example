# SentinelAI Platform Configuration

# App
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database
# Default: async SQLite for zero-setup local dev; use PostgreSQL async for production
DATABASE_URL=sqlite+aiosqlite:///./sentinelai.db
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinelsecret@localhost:5432/sentinelai
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_IN_MEMORY=true

# Multi-LLM Providers (Mock provider activates if no keys configured)
DEFAULT_LLM_PROVIDER=mock
DEFAULT_LLM_MODEL=mock-sentinel-v1

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ENABLE_STRUCTURED_LOGGING=true


