# SentinelAI Platform Configuration

# App
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database
# Use SQLite async for lightweight standalone operation or PostgreSQL async for enterprise production
DATABASE_URL=sqlite+aiosqlite:///./sentinelai.db
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@localhost:5432/sentinelai

# LLM Providers (Optional for local testing - MockLLM works with zero credentials)
GROQ_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=mock
DEFAULT_LLM_MODEL=mock-sentinel-v1

# Qdrant Vector Store
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Set true to use in-memory vector store without requiring Qdrant container
QDRANT_IN_MEMORY=true

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ENABLE_STRUCTURED_LOGGING=true
